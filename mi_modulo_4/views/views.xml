<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="workout_plan_view_form_inherit_bi" model="ir.ui.view">
        <field name="name">workout.plan.view.form.inherit.bi</field>
        <field name="model">workout.plan</field>
        <field name="inherit_id" ref="gym_mgmt_system.workout_plan_view_form"/>
        <field name="arch" type="xml">
            
            <xpath expr="//group" position="before">
                <!-- Barra de progreso visual que cruza todo el formulario -->
                <field name="progress" widget="progressbar" title="Progreso del Entrenamiento"/>
            </xpath>

            <xpath expr="//group" position="inside">
                <group string="Detalles de Ejecución">
                    <!-- Widget priority convierte la selección en estrellas interactivas -->
                    <field name="difficulty" widget="priority"/>
                    <field name="trainer_id"/>
                </group>
                <group string="Planificación de Tiempo">
                    <field name="date_start"/>
                    <field name="date_end"/>
                    <!-- Control manual para probar la barra de progreso -->
                    <field name="completed_exercises"/>
                    <field name="total_exercises" invisible="1"/>
                </group>
            </xpath>

        </field>
    </record>

    <record id="workout_plan_view_calendar" model="ir.ui.view">
        <field name="name">workout.plan.view.calendar</field>
        <field name="model">workout.plan</field>
        <field name="arch" type="xml">
            <calendar string="Calendario de Entrenamientos" date_start="date_start" date_stop="date_end" color="trainer_id" mode="week">
                <field name="name"/>
                <field name="difficulty"/>
            </calendar>
        </field>
    </record>

    <record id="workout_plan_view_graph" model="ir.ui.view">
        <field name="name">workout.plan.view.graph</field>
        <field name="model">workout.plan</field>
        <field name="arch" type="xml">
            <graph string="Análisis de Entrenadores" type="bar">
                <field name="trainer_id" type="row"/>
                <field name="difficulty" type="col"/>
                <field name="total_exercises" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="workout_plan_view_pivot" model="ir.ui.view">
        <field name="name">workout.plan.view.pivot</field>
        <field name="model">workout.plan</field>
        <field name="arch" type="xml">
            <pivot string="Data Analysis: Entrenamientos">
                <field name="trainer_id" type="row"/>
                <field name="date_start" type="col" interval="month"/>
                <field name="total_exercises" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="gym_mgmt_system.workout_plan_action" model="ir.actions.act_window">
        <field name="view_mode">list,form,calendar,graph,pivot</field>
    </record>

</odoo>