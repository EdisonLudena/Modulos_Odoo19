<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="blood_discard_log_view_tree" model="ir.ui.view">
        <field name="name">blood.discard.log.view.tree</field>
        <field name="model">blood.discard.log</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0" decoration-danger="1">
                <field name="discard_date"/>
                <field name="name"/>
                <field name="blood_type"/>
                <field name="reason"/>
                <field name="responsible_id"/>
            </list>
        </field>
    </record>

    <record id="blood_discard_log_view_graph" model="ir.ui.view">
        <field name="name">blood.discard.log.view.graph</field>
        <field name="model">blood.discard.log</field>
        <field name="arch" type="xml">
            <graph string="Análisis de Desperdicio de Sangre" type="pie">
                <field name="blood_type" type="row"/>
            </graph>
        </field>
    </record>

    <record id="blood_discard_log_action" model="ir.actions.act_window">
        <field name="name">Auditoría de Descartes</field>
        <field name="res_model">blood.discard.log</field>
        <field name="view_mode">list,graph</field>
    </record>

    <menuitem id="blood_discard_log_menu" name="Logs de Descarte" parent="base_hospital_management.hospital_menu_configuration" action="blood_discard_log_action" sequence="8"/>

    <record id="blood_bank_view_form_inherit_advanced" model="ir.ui.view">
        <field name="name">blood.bank.view.form.inherit.advanced</field>
        <field name="model">blood.bank</field>
        <field name="inherit_id" ref="base_hospital_management.blood_bank_view_form"/>
        <field name="arch" type="xml">
            
            <xpath expr="//sheet" position="before">
                <div class="alert alert-warning" role="alert" invisible="is_critical == False or state != 'avail'" style="margin-bottom: 0px;">
                    <strong>¡Urgente!</strong> Esta bolsa caduca en 3 días o menos. Priorizar su uso.
                </div>
            </xpath>

            <xpath expr="//div[hasclass('oe_title')]" position="before">
                <div class="oe_button_box" name="button_box">
                    <button name="action_view_discard_logs" type="object" class="oe_stat_button" icon="fa-history" invisible="discard_log_count == 0">
                        <field name="discard_log_count" widget="statinfo" string="Auditoría"/>
                    </button>
                </div>
            </xpath>

            <xpath expr="//field[@name='date']" position="after">
                <field name="expiration_date" readonly="1" force_save="1"/>
                <field name="days_to_expire" invisible="state != 'avail'"/>
                <field name="is_critical" invisible="1"/>
            </xpath>

            <xpath expr="//header/button[@name='action_blood_available']" position="attributes">
                 <attribute name="invisible">state in ('not', 'expired')</attribute>
            </xpath>

        </field>
    </record>

    <record id="blood_bank_view_tree_inherit_advanced" model="ir.ui.view">
        <field name="name">blood.bank.view.tree.inherit.advanced</field>
        <field name="model">blood.bank</field>
        <field name="inherit_id" ref="base_hospital_management.blood_bank_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="attributes">
                <attribute name="decoration-danger">state == 'expired'</attribute>
                <attribute name="decoration-warning">is_critical == True and state == 'avail'</attribute>
            </xpath>
            <xpath expr="//field[@name='date']" position="after">
                <field name="expiration_date" optional="show"/>
                <field name="days_to_expire" optional="show" widget="badge" decoration-warning="is_critical == True" decoration-success="is_critical == False"/>
            </xpath>
        </field>
    </record>

    <record id="blood_bank_view_kanban_inherit_advanced" model="ir.ui.view">
        <field name="name">blood.bank.view.kanban.inherit.advanced</field>
        <field name="model">blood.bank</field>
        <field name="inherit_id" ref="base_hospital_management.blood_bank_view_kanban"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='state']" position="replace">
                <field name="state" widget="badge"
                       decoration-success="state == 'avail'"
                       decoration-warning="state == 'not'"
                       decoration-danger="state == 'expired'"/>
            </xpath>
        </field>
    </record>

</odoo>