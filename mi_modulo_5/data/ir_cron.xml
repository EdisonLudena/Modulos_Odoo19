<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="ir_cron_pharmacy_stock_monitor" model="ir.cron">
            <field name="name">Farmacia: Monitoreo Automático de Stock Crítico</field>
            <field name="model_id" ref="base_hospital_management.model_hospital_pharmacy"/>
            <field name="state">code</field>           
            <field name="code">model._cron_check_pharmacy_stock()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>

        <record id="ir_cron_blood_bank_expiration" model="ir.cron">
            <field name="name">Banco de Sangre: Auditoría y Descarte Automático</field>
            <field name="model_id" ref="base_hospital_management.model_blood_bank"/>
            <field name="state">code</field>           
            <field name="code">model.action_change_availability()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">12</field>
            <field name="interval_type">hours</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>